[Unit]
Description=Curio — a curiosity engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=io
Group=io
WorkingDirectory=/home/io/curio/backend
EnvironmentFile=/home/io/curio/backend/.env

# Waitress rather than gunicorn: smaller resident footprint, and threads are
# the right model here since every request is I/O-bound on OpenRouter.
# 4 threads is plenty for a personal app and keeps RSS well under the 80MB target.
ExecStart=/home/io/curio/backend/.venv/bin/waitress-serve \
    --listen=127.0.0.1:5000 \
    --threads=4 \
    --call wsgi:build

Restart=on-failure
RestartSec=5

# The Pi has 1GB shared with other services. Fail loudly rather than swap.
MemoryMax=200M

# Hardening — this process only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/io/curio
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=curio

[Install]
WantedBy=multi-user.target
