# Copy to backend/.env and fill in. Never commit the real file.

# ── Core ───────────────────────────────────────────────────────────────
# Pin this, or the app generates one next to the DB (restarts stay logged in
# either way, but pinning is tidier).
CURIO_SECRET_KEY=
CURIO_DB=/home/io/curio/curio.db
CURIO_STATIC_DIR=/home/io/curio/frontend/dist
CURIO_PUBLIC_URL=https://curio.example.com

# Set to 0 only for local http development.
CURIO_COOKIE_SECURE=1

# ── OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Starting fallback chain. The free list churns — re-pick from /admin.
CURIO_MODEL_CHAIN=meta-llama/llama-3.3-70b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free

# ── Abuse guards ───────────────────────────────────────────────────────
# Signup is open, so these protect the shared free-model daily quota.
CURIO_DAILY_CAP_USER=300
CURIO_DAILY_CAP_ANON_IP=40
CURIO_SIGNUP_CAP_IP=5

# ── Admin ──────────────────────────────────────────────────────────────
# The first account created with this email becomes the single admin.
CURIO_ADMIN_EMAIL=you@example.com

# ── Email (Gmail SMTP + app password) ──────────────────────────────────
# Easiest path: `bash deploy/set-email.sh`, which reads the password without
# echoing it. The port picks the transport — 465 is implicit TLS, 587 opens in
# clear and upgrades via STARTTLS. Gmail accepts both; they are not
# interchangeable, so set the one you mean.
CURIO_SMTP_HOST=smtp.gmail.com
CURIO_SMTP_PORT=465
CURIO_SMTP_USER=you@gmail.com
CURIO_SMTP_PASSWORD=your-16-char-app-password
CURIO_MAIL_FROM=you@gmail.com
CURIO_MAIL_FROM_NAME=Curio
# Print emails to the log instead of sending. Useful on first deploy.
CURIO_MAIL_DRY_RUN=0
# "Send around" is each user's local hour; the browser reports their timezone
# when they save settings. This is the fallback for accounts saved before that
# existed (or browsers that won't say). IANA name, e.g. America/New_York.
CURIO_DEFAULT_TZ=America/New_York
