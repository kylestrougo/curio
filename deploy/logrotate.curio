# Curio's cron logs. Install with:
#   sudo cp /home/io/curio/deploy/logrotate.curio /etc/logrotate.d/curio
#
# Without this the four cron jobs append forever. The hourly email job alone
# writes a line every hour, and this is an SD card — small, and unpleasant to
# recover once it fills. systemd's own logs are handled by journald and are not
# affected by this file.
/home/io/curio/logs/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 io io
}
